# Copy this file to .env and fill in real values. NEVER commit .env
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jobboard?retryWrites=true&w=majority
JWT_SECRET=change_me_long_random_string
JWT_REFRESH_SECRET=change_me_another_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:5173

# First admin account (used by: npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123

# AI cover letter (optional - a template is used when empty). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Status emails (optional - skipped when empty). Gmail: use an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Student Job Board <your@gmail.com>
